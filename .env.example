# Where form submissions (free audit, report requests, newsletter) are sent.
# Any URL that accepts a JSON POST: Zapier/Make webhook, Slack incoming webhook, CRM endpoint...
# Without it, leads are only written to the server log (Vercel → Logs).
LEAD_WEBHOOK_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
# Update the Privacy Policy cookies section before enabling it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
