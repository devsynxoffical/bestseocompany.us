{
  "name": "bestseocompany-us",
  "version": "1.0.0",
  "private": true,
  "description": "Homepage for bestseocompany.us, a US SEO agency. Built with Next.js App Router.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seo:export": "node --experimental-strip-types --no-warnings scripts/seo-export.mts",
    "build:hostinger": "bash scripts/build-hostinger.sh",
    "seo:uniq": "node scripts/location-uniq.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
