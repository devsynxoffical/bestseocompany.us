# bestseocompany.us on Hostinger (Apache / LiteSpeed)
# Static Next.js export + PHP endpoints. Generated by scripts/build-hostinger.sh

Options -MultiViews -Indexes
DirectoryIndex index.html index.php
# Pages exist both as "industries.html" and as an "industries/" folder: never auto-add a trailing slash.
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1) Canonical host: https://www.bestseocompany.us (only for the real domain, so Hostinger previews keep working)
RewriteCond %{HTTP_HOST} ^bestseocompany\.us$ [NC]
RewriteRule ^ https://www.bestseocompany.us%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.bestseocompany\.us$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://www.bestseocompany.us%{REQUEST_URI} [R=301,L]

# 2) Permanent redirects (same as next.config.ts on Vercel)
RewriteRule ^tools/?$ /tools/free-seo-tools [R=301,L]
RewriteRule ^industries/healthcare-seo/?$ /industries/medical-seo [R=301,L]
RewriteRule ^industries/car-dealership-seo/?$ /industries/car-dealer-seo [R=301,L]

# 3) API endpoints -> PHP (keeps the URLs the site's JavaScript calls)
RewriteRule ^api/lead/?$ api/lead.php [L]
RewriteRule ^api/audit/?$ api/audit.php [L]

# 4) Clean URLs: /page.html -> /page (301), and trailing slash -> no slash
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteCond %1 !^404$
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1 [R=301,L]

# 5) Serve /page from page.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Extension-less images generated by Next.js (social share images, Apple icon)
<FilesMatch "^(opengraph-image|apple-icon)$">
  ForceType image/png
</FilesMatch>
AddType application/manifest+json .webmanifest
AddType text/plain .txt
AddType application/rss+xml .xml
<FilesMatch "^sitemap(-locations)?\.xml$">
  ForceType application/xml
</FilesMatch>

# Keep config and docs private
<FilesMatch "^(config\.php|HOSTINGER-README\.md)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Hostinger preview/temporary domains must not be indexed
  SetEnvIfNoCase Host "hostingersite\.com$|\.hostinger\." NOINDEX_HOST
  Header always set X-Robots-Tag "noindex, nofollow" env=NOINDEX_HOST
  # Long cache for fingerprinted build assets, revalidate HTML
  <FilesMatch "\.(js|css|woff2|svg|png|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/_next/static/#"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
